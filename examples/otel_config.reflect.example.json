{
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "OTEL_SERVICE_NAME": "coding-agent",
  "batch": {
    "on_stop": true
  },
  "local_spans": true,
  "capture": {
    "mode": "full",
    "span_include": [
      "cwd",
      "file_path",
      "workspace_path",
      "root_workspace_path",
      "transcript_path",
      "command",
      "exit_code",
      "tool_input",
      "tool_output",
      "tool_response.output",
      "tool_response.stdout",
      "tool_response.exit_code",
      "tool_response.status",
      "tool_response.is_error",
      "tool_response.success",
      "tool_response.duration_ms",
      "metadata",
      "model_params",
      "usage",
      "tool_calls.*.tool_name",
      "tool_calls.*.tool_use_id",
      "prompt",
      "user_prompt",
      "last_assistant_message",
      "response",
      "prompt_response",
      "tool_info.cwd",
      "tool_info.file_path",
      "tool_info.command_line",
      "tool_info.user_prompt",
      "tool_info.response",
      "tool_info.mcp_tool_arguments",
      "tool_info.mcp_result.output",
      "tool_info.mcp_result.exit_code",
      "tool_info.mcp_result.status",
      "tool_result.text_result_for_llm",
      "llm_request.model",
      "permission_request_id",
      "elicitation_id",
      "tool_call_id",
      "call_id",
      "task_id",
      "agent_id",
      "parent_agent_id"
    ],
    "mappings": {
      "prompt": "gen_ai.client.prompt",
      "user_prompt": "gen_ai.client.prompt",
      "last_assistant_message": "gen_ai.client.output",
      "response": "gen_ai.client.output",
      "prompt_response": "gen_ai.client.output",
      "tool_output": "gen_ai.client.tool.output",
      "tool_response.output": "gen_ai.client.tool.output",
      "tool_response.exit_code": "process.exit.code",
      "exit_code": "process.exit.code",
      "tool_input.command": "gen_ai.client.tool.input",
      "tool_info.user_prompt": "gen_ai.client.prompt",
      "tool_info.response": "gen_ai.client.output",
      "tool_info.mcp_tool_arguments.command": "gen_ai.client.tool.input",
      "tool_info.mcp_result.output": "gen_ai.client.tool.output",
      "tool_info.mcp_result.exit_code": "process.exit.code",
      "tool_result.text_result_for_llm": "gen_ai.client.tool.output",
      "tool_input.file_path": "gen_ai.client.tool.input.file_path",
      "tool_info.mcp_tool_arguments.file_path": "gen_ai.client.tool.input.file_path",
      "tool_input.path": "gen_ai.client.tool.input.path",
      "tool_info.mcp_tool_arguments.path": "gen_ai.client.tool.input.path",
      "tool_input.cwd": "gen_ai.client.tool.input.cwd",
      "tool_info.mcp_tool_arguments.cwd": "gen_ai.client.tool.input.cwd",
      "tool_input.skill": "gen_ai.client.tool.input.skill",
      "tool_info.mcp_tool_arguments.skill": "gen_ai.client.tool.input.skill",
      "tool_input.subagent_type": "gen_ai.client.tool.input.subagent_type",
      "tool_info.mcp_tool_arguments.subagent_type": "gen_ai.client.tool.input.subagent_type",
      "tool_input.agent_type": "gen_ai.client.tool.input.agent_type",
      "tool_info.mcp_tool_arguments.agent_type": "gen_ai.client.tool.input.agent_type",
      "tool_input.agent_id": "gen_ai.client.tool.input.agent_id",
      "tool_info.mcp_tool_arguments.agent_id": "gen_ai.client.tool.input.agent_id",
      "tool_input.name": "gen_ai.client.tool.input.name",
      "tool_info.mcp_tool_arguments.name": "gen_ai.client.tool.input.name",
      "tool_input.description": "gen_ai.client.tool.input.description",
      "tool_info.mcp_tool_arguments.description": "gen_ai.client.tool.input.description",
      "tool_input.server": "gen_ai.client.mcp_server",
      "tool_info.mcp_tool_arguments.server": "gen_ai.client.mcp_server",
      "tool_input.tool": "gen_ai.client.tool.input.tool",
      "tool_info.mcp_tool_arguments.tool": "gen_ai.client.tool.input.tool",
      "tool_input.tool_name": "gen_ai.client.mcp_tool",
      "tool_info.mcp_tool_arguments.tool_name": "gen_ai.client.mcp_tool"
    },
    "max_attributes": 96,
    "max_string_length": 4000,
    "max_depth": 16,
    "max_array_length": 128,
    "max_attribute_bytes": 32768
  },
  "logs": {
    "enabled": true
  },
  "diagnostics": {
    "level": "WARNING"
  },
  "OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT": 256
}
