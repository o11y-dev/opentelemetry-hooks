{
  "_comment": "Template for Cursor hooks. Replace {{SCRIPT_PATH}} with the hook command. For a copied-source checkout use 'python3 .cursor/hooks/opentelemetry-hook/otel_hook.py' (the default set by setup.sh); use 'otel-hook' only for a pip-installed package.",
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "{{SCRIPT_PATH}}" }],
    "sessionEnd": [{ "command": "{{SCRIPT_PATH}}" }],
    "subagentStart": [{ "command": "{{SCRIPT_PATH}}" }],
    "subagentStop": [{ "command": "{{SCRIPT_PATH}}" }],
    "preToolUse": [{ "command": "{{SCRIPT_PATH}}" }],
    "postToolUse": [{ "command": "{{SCRIPT_PATH}}" }],
    "postToolUseFailure": [{ "command": "{{SCRIPT_PATH}}" }],
    "beforeShellExecution": [{ "command": "{{SCRIPT_PATH}}" }],
    "afterShellExecution": [{ "command": "{{SCRIPT_PATH}}" }],
    "beforeMCPExecution": [{ "command": "{{SCRIPT_PATH}}" }],
    "afterMCPExecution": [{ "command": "{{SCRIPT_PATH}}" }],
    "beforeReadFile": [{ "command": "{{SCRIPT_PATH}}" }],
    "afterFileEdit": [{ "command": "{{SCRIPT_PATH}}" }],
    "beforeSubmitPrompt": [{ "command": "{{SCRIPT_PATH}}" }],
    "stop": [{ "command": "{{SCRIPT_PATH}}" }]
  }
}
