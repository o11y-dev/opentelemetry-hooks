{
  "_comment": "Template for Cursor hooks. Replace {{SCRIPT_PATH}} with the hook command. For a copied-source checkout use 'python3 .cursor/hooks/opentelemetry-hook/otel_hook.py' (the default set by setup.sh); use 'otel-hook' only for a pip-installed package.",
  "version": 1,
  "hooks": {
    "sessionStart": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "sessionEnd": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "subagentStart": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "subagentStop": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "preToolUse": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "postToolUse": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "postToolUseFailure": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "beforeShellExecution": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterShellExecution": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "beforeMCPExecution": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterMCPExecution": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "beforeReadFile": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterFileEdit": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "beforeSubmitPrompt": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "stop": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "preCompact": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "beforeTabFileRead": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterTabFileEdit": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterAgentResponse": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "afterAgentThought": [{"command": "{{SCRIPT_PATH}} --cursor"}],
    "workspaceOpen": [{"command": "{{SCRIPT_PATH}} --cursor"}]
  }
}
