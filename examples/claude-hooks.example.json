{
  "_comment": "Template for Claude Code hooks. Replace {{SCRIPT_PATH}} with the hook command (default: otel-hook).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "claude" } }
        ]
      }
    ]
  }
}
