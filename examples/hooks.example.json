{
  "_comment": "Cursor hooks template. Replace {{SCRIPT_PATH}} with the hook command. For a copied-source checkout use 'python3 .cursor/hooks/opentelemetry-hook/otel_hook.py' (the default set by setup.sh); use 'otel-hook' only for a pip-installed package. Copy to .cursor/hooks.json to enable.",
  "_comment_merge": "If you already have .cursor/hooks.json, merge the hooks section instead of overwriting it.",
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "sessionEnd": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "subagentStart": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "subagentStop": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "preToolUse": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "postToolUse": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "postToolUseFailure": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "beforeShellExecution": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "afterShellExecution": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "beforeMCPExecution": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "afterMCPExecution": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "beforeReadFile": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "afterFileEdit": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "beforeSubmitPrompt": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }],
    "stop": [{ "command": "{{SCRIPT_PATH}}", "env": { "IDE_OTEL_IDE_NAME": "cursor" } }]
  }
}
