{
  "_comment": "Template for GitHub Copilot. Replace {{SCRIPT_PATH}} (default: otel-hook) and adjust timeoutSec if needed.",
  "_comment_timeout": "timeoutSec is in seconds. Default is 30.",
  "version": 1,
  "hooks": {
    "sessionStart": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }],
    "sessionEnd": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }],
    "userPromptSubmitted": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }],
    "preToolUse": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }],
    "postToolUse": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }],
    "errorOccurred": [{ "type": "command", "bash": "env IDE_OTEL_IDE_NAME=copilot {{SCRIPT_PATH}}", "timeoutSec": 30 }]
  }
}
