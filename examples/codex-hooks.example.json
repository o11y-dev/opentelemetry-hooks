{
  "_comment": "Template for Codex hooks. Replace {{SCRIPT_PATH}} with the hook command. For a source checkout use 'python3 /absolute/path/to/otel_hook.py'; use 'otel-hook' when installed via pipx or pip. Enable hooks with [features] hooks = true in Codex config.toml.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}], "matcher": "startup|resume|clear|compact"}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}], "matcher": "*"}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}], "matcher": "*"}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}], "matcher": "*"}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 3}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 30}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "{{SCRIPT_PATH}} --codex", "timeout": 3}]}]
  }
}
